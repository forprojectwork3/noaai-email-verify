<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ========== MAIN CONTENT ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background">

        <!-- TOP APP BAR -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/background"
            android:elevation="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- NOA AI Text Logo (left) -->
            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.2"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Hamburger menu (right) -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_menu"
                android:padding="12dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/text_primary" />

        </androidx.appcompat.widget.Toolbar>

        <!-- Thin accent divider under toolbar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <!-- SCROLLABLE WORKSPACE -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ── URL INPUT FIELD ── -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilYoutubeUrl"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:boxCornerRadiusBottomEnd="24dp"
                    app:boxCornerRadiusBottomStart="24dp"
                    app:boxCornerRadiusTopEnd="24dp"
                    app:boxCornerRadiusTopStart="24dp"
                    app:boxStrokeColor="@color/input_border"
                    app:boxStrokeWidth="1.5dp"
                    app:hintTextColor="@color/text_hint"
                    app:startIconDrawable="@android:drawable/ic_search_category_default"
                    app:startIconTint="@color/gradient_start">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etYoutubeUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_youtube_url"
                        android:imeOptions="actionDone"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ── YOUTUBE PLAYER CARD ── -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardYouTubePlayer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp">

                    <!-- 16:9 Aspect Ratio container -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                            android:id="@+id/youTubePlayerView"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:autoPlay="false"
                            app:enableAutomaticInitialization="false"
                            app:layout_constraintDimensionRatio="16:9"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- Error Overlay View -->
                        <LinearLayout
                            android:id="@+id/llPlayerErrorOverlay"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="20dp"
                            android:background="#202020"
                            android:visibility="gone"
                            app:layout_constraintDimensionRatio="16:9"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@android:drawable/ic_dialog_alert"
                                app:tint="#FFB347"
                                android:layout_marginBottom="8dp"
                                android:contentDescription="Error Warning" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Playback Restricted"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/tvPlayerErrorOverlayMessage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="This video cannot be played inside the app because embedding is disabled."
                                android:textColor="#BDBDBD"
                                android:textSize="12sp"
                                android:gravity="center" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

                <!-- ── ACTION GRID LABEL ── -->
                <TextView
                    android:id="@+id/tvActionsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:text="AI Actions"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textAllCaps="true" />

                <!-- ── 2×2 ACTION BUTTON GRID ── -->
                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/gridActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:columnCount="2"
                    app:rowCount="2"
                    app:useDefaultMargins="false">

                    <!-- Row 1, Col 1 — Summarize -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSummarize"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_margin="6dp"
                        android:alpha="0.4"
                        android:enabled="false"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.03"
                        android:text="@string/btn_summarize"
                        android:textColor="@color/on_primary"
                        android:textSize="14sp"
                        app:backgroundTint="@null"
                        android:background="@drawable/gradient_button"
                        app:cornerRadius="16dp"
                        app:layout_column="0"
                        app:layout_columnWeight="1"
                        app:layout_row="0" />

                    <!-- Row 1, Col 2 — Transcript -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTranscript"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_margin="6dp"
                        android:alpha="0.4"
                        android:enabled="false"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.03"
                        android:text="@string/btn_transcript"
                        android:textColor="@color/on_primary"
                        android:textSize="14sp"
                        app:backgroundTint="@null"
                        android:background="@drawable/gradient_button"
                        app:cornerRadius="16dp"
                        app:layout_column="1"
                        app:layout_columnWeight="1"
                        app:layout_row="0" />

                    <!-- Row 2, Col 1 — Timestamps -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStudyPlan"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_margin="6dp"
                        android:alpha="0.4"
                        android:enabled="false"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.03"
                        android:text="@string/chip_timestamps"
                        android:textColor="@color/on_primary"
                        android:textSize="14sp"
                        app:backgroundTint="@null"
                        android:background="@drawable/gradient_button"
                        app:cornerRadius="16dp"
                        app:layout_column="0"
                        app:layout_columnWeight="1"
                        app:layout_row="1" />

                    <!-- Row 2, Col 2 — Chat with AI -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBriefNotes"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_margin="6dp"
                        android:alpha="0.4"
                        android:enabled="false"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.03"
                        android:text="Chat with AI"
                        android:textColor="@color/on_primary"
                        android:textSize="14sp"
                        app:backgroundTint="@null"
                        android:background="@drawable/gradient_button"
                        app:cornerRadius="16dp"
                        app:layout_column="1"
                        app:layout_columnWeight="1"
                        app:layout_row="1" />

                </androidx.gridlayout.widget.GridLayout>

                <!-- Bottom padding spacer -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- ========== NAVIGATION DRAWER (CUSTOM MINIMAL SIDEBAR) ========== -->
    <LinearLayout
        android:id="@+id/sidebarDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_sidebar_glass"
        android:orientation="vertical"
        android:padding="16dp"
        android:clickable="true"
        android:focusable="true">

        <!-- TOP SECTION -->
        <ImageView
            android:id="@+id/ivSidebarLogo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_noa_logo"
            android:contentDescription="NOA AI Logo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewChat"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:text="+ New Chat"
            android:textColor="@color/on_primary"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/gradient_button"
            app:backgroundTint="@null"
            app:cornerRadius="24dp"
            android:gravity="center" />

        <!-- MIDDLE SECTION (Recents History) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"
            android:text="Recents"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never" />

        <!-- RECENT SIDEBAR LOGOUT -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clickable="true"
            android:focusable="true">
            
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_logout"
                app:tint="@color/text_secondary"
                android:contentDescription="Logout Icon" />
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Log Out"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- BOTTOM USER SECTION -->
        <LinearLayout
            android:id="@+id/llUserSection"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clickable="true"
            android:focusable="true">

            <androidx.cardview.widget.CardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent">
                                <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivUserAvatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_profile_placeholder"
                        android:scaleType="centerCrop"
                        android:contentDescription="User Avatar"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerFamilyRounded"
                        app:strokeWidth="0dp" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNavHeaderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Name"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvNavHeaderEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="user@email.com"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_gear"
                app:tint="@color/text_secondary"
                android:contentDescription="Settings Icon" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
